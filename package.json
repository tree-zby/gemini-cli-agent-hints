{
  "name": "gemini-cli-agent-hints",
  "version": "0.1.0",
  "description": "Agent Hint protocol (X-Agent-Hint, v1.0) sender for Gemini CLI: session, lifecycle, priority and KV-cache hints over HTTP headers.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tree-zby/gemini-cli-agent-hints.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gemini-agent-hints": "dist/cli.js"
  },
  "files": [
    "dist",
    "hooks",
    "patches",
    "docs",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
